DECLARE Board : ARRAY[1:2,1:3] OF CHAR
DECLARE Row : INTEGER
DECLARE Column : INTEGER

FOR Row ← 1 TO 2
   FOR Column ← 1 TO 3
      Board[Row, Column] ← '-'
   NEXT Column
NEXT Row

Board[1,2] ← 'X'
Board[2,3] ← 'O'

OUTPUT Board[1,1], Board[1,2], Board[1,3]
OUTPUT Board[2,1], Board[2,2], Board[2,3]

CASE OF Board[1,2]
   'X' : OUTPUT "X moved"
   'O' : OUTPUT "O moved"
   OTHERWISE : OUTPUT "No move"
ENDCASE
